{
  "uid": "notification-flow",
  "title": "Notification flow",
  "tags": ["notification-hub"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 41,
  "editable": false,
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "1 · Intake",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Accepted per second, by channel",
      "description": "New notifications written as PENDING. A repeated Idempotency-Key is not counted.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 1, "w": 9, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel) (rate(notifications_accepted_total[1m]))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Refused per second, by reason",
      "description": "Intake requests answered with a refusal. One reason per thing the caller has to fix.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 9, "y": 1, "w": 9, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "softMax": 1 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "idempotency_key_reused" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#CC79A7" } }]
          },
          {
            "matcher": { "id": "byName", "options": "invalid_body" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#E69F00" } }]
          },
          {
            "matcher": { "id": "byName", "options": "invalid_header" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#56B4E9" } }]
          },
          {
            "matcher": { "id": "byName", "options": "not_acceptable" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#999999" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unacceptable_recipient" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#D55E00" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unauthenticated" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#F0E442" } }]
          },
          {
            "matcher": { "id": "byName", "options": "undeliverable_channel" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#009E73" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unreadable_body" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#0072B2" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unsupported_media_type" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#9467BD" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(notifications_refused_total[1m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Idempotent replays in range",
      "description": "Answers 202 that created nothing: the caller got the identifier of its first request back.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(notifications_replayed_total[$__range])))",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "id": 5,
      "title": "2 · Queue",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 9, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Rows in the queue, by status",
      "description": "PENDING: waiting for a claim, now or after a retry delay. DISPATCHING: claimed by an instance, either being delivered or waiting in its worker queue. Every instance reads the same table, hence max() and not sum(). A gap means the last reading failed.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 10, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (status) (notifications_queue_rows)",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Pending now",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 10, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(notifications_queue_rows{status=\"PENDING\"})"
        }
      ]
    },
    {
      "type": "stat",
      "id": 8,
      "title": "Claimed now",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 10, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "area" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(notifications_queue_rows{status=\"DISPATCHING\"})"
        }
      ]
    },
    {
      "type": "row",
      "id": 9,
      "title": "3 · Claim",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Accepted and claimed per second",
      "description": "Every attempt is a claim, retries included, so claimed runs above accepted while deliveries are retried. Accepted above claimed for long means the queue grows.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(notifications_accepted_total[1m]))",
          "legendFormat": "accepted"
        },
        {
          "refId": "B",
          "expr": "sum(rate(notifications_claims_total[1m]))",
          "legendFormat": "claimed"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Claimed per second, by channel",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 19, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel) (rate(notifications_claims_total[1m]))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 12,
      "title": "Claims per accepted notification",
      "description": "1 when every notification is delivered on its first attempt. Each retry adds to it.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 19, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(notifications_claims_total[$__range])) / sum(increase(notifications_accepted_total[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 26,
      "title": "Wait from due to claimed p95, by priority",
      "description": "How long a due row waited before a worker claimed it: the queue latency. A retry counts from its own next attempt, so backoffs are not included.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 27, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, priority) (rate(notifications_claim_delay_seconds_bucket[5m])))",
          "legendFormat": "{{priority}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 13,
      "title": "4 · Delivery",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 35, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 14,
      "title": "Attempts per second, by outcome",
      "description": "SUCCESS: 2xx. RETRYABLE_FAILURE: 5xx, 429, timeout or refused connection. PERMANENT_FAILURE: any other 4xx, a redirect, or a refused address. Outcome of the attempt, not of the notification.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 36, "w": 9, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SUCCESS" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "RETRYABLE_FAILURE" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byName", "options": "PERMANENT_FAILURE" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(notifications_attempts_total[1m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 15,
      "title": "Attempt duration p95, by outcome",
      "description": "A timeout lasts as long as the read timeout, so retryable failures pile up near that value.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 9, "y": 36, "w": 9, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SUCCESS" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "RETRYABLE_FAILURE" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }]
          },
          {
            "matcher": { "id": "byName", "options": "PERMANENT_FAILURE" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(notifications_delivery_duration_seconds_bucket[5m])))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 16,
      "title": "Attempts that succeeded",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 36, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(notifications_attempts_total{outcome=\"SUCCESS\"}[$__range])) / sum(increase(notifications_attempts_total[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "row",
      "id": 17,
      "title": "5 · Outcome",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 44, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 18,
      "title": "Settled per second, by result",
      "description": "A notification settles once: sent on a 2xx, failed on a permanent failure or when a retryable one runs out of attempts.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 45, "w": 9, "h": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0 },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "sent" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(notifications_settled_total[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 19,
      "title": "Retries scheduled per second, by channel",
      "description": "Retryable failures sent back to PENDING with a backoff. They return as claims once the backoff ends.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 9, "y": 45, "w": 9, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (channel) (rate(notifications_retries_total[1m]))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 20,
      "title": "Notifications delivered",
      "description": "Sent out of every notification that settled in the range.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 45, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1, "min": 0, "max": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(notifications_settled_total{result=\"sent\"}[$__range])) / sum(increase(notifications_settled_total[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 25,
      "title": "Acceptance to settlement p95, by priority",
      "description": "End to end, retries and backoffs included: what a caller waits for. Delivered notifications only; failures are timed under result=\"failed\".",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 53, "w": 24, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, priority) (rate(notifications_delivery_latency_seconds_bucket{result=\"sent\"}[5m])))",
          "legendFormat": "{{priority}}"
        }
      ]
    },
    {
      "type": "row",
      "id": 21,
      "title": "6 · Recovery",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 61, "w": 24, "h": 1 },
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 22,
      "title": "Abandoned claims released",
      "description": "Rows left DISPATCHING longer than the stale claim timeout, put back to PENDING by the reaper. Zero on a healthy system: anything here means an instance died mid-delivery, and those notifications may be delivered twice.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 62, "w": 9, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0, "min": 0, "softMax": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(notifications_claims_released_total[1m])))",
          "legendFormat": "released"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 23,
      "title": "Dispatch errors per second, by kind",
      "description": "claim_lost: the attempt finished after its row was released and claimed again, so its result was discarded. unexpected: a failure outside the delivery itself, the row stays claimed until the reaper releases it.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 9, "y": 62, "w": 9, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "softMax": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(notifications_dispatch_errors_total[1m]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "stat",
      "id": 24,
      "title": "Claims released in range",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 62, "w": 6, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "none", "graphMode": "none" },
      "targets": [
        {
          "refId": "A",
          "expr": "round(sum(increase(notifications_claims_released_total[$__range])))",
          "instant": true
        }
      ]
    }
  ]
}
